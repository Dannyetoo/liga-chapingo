DirectoryIndex index.html
Options -Indexes
<FilesMatch "^(lib\.php|torneo-lib\.php|migrar\.php|activa\.php)$|\.(sql|md|test\.cjs)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
 Header set Cache-Control "no-store"
 Header set X-Content-Type-Options "nosniff"
 Header set X-Frame-Options "DENY"
 Header set Referrer-Policy "same-origin"
 Header set X-Robots-Tag "noindex, nofollow"
 Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
