/* «Busca un rival»: contador de 3 opciones, confirmaciones y actualización automática. */
(function () {
  'use strict';
  var N = 3;
  var form = document.getElementById('form-publicar');
  if (form) {
    var cajas = form.querySelectorAll('input[name="slots[]"]');
    var cont = document.getElementById('contador'), btn = document.getElementById('btn-publicar');
    var pintar = function () {
      var n = form.querySelectorAll('input[name="slots[]"]:checked').length;
      cont.textContent = n + ' de ' + N + ' horarios elegidos' + (n > N ? ' — quita ' + (n - N) : '');
      cont.className = 'rv-contador' + (n === N ? ' rv-contador--ok' : '');
      btn.disabled = n !== N;
      cajas.forEach(function (c) { if (!c.checked && !c.hasAttribute('data-off')) c.disabled = n >= N; });
    };
    cajas.forEach(function (c) { if (c.disabled) c.setAttribute('data-off', ''); c.addEventListener('change', pintar); });
    pintar();
  }
  document.addEventListener('click', function (ev) {
    var b = ev.target.closest('[data-confirmar]');
    if (b && !window.confirm(b.getAttribute('data-confirmar'))) ev.preventDefault();
  });
  // Actualización automática: si algo cambió en el grupo, recarga (salvo que esté eligiendo horarios).
  var v = document.body.getAttribute('data-version');
  if (!v || !window.fetch) return;
  // No recargar mientras el capitán está eligiendo horarios o escribiendo una reprogramación.
  var ocupado = function () {
    if (form && form.querySelectorAll('input[name="slots[]"]:checked').length > 0) return true;
    if (document.querySelector('details.rv-reprog[open]')) return true;
    var a = document.activeElement;
    return !!(a && /^(SELECT|INPUT|TEXTAREA)$/.test(a.tagName));
  };
  setInterval(function () {
    if (document.hidden) return;
    fetch('rival-estado.php', { credentials: 'same-origin', cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || !d.ok) return;
        if (d.v !== v) {
          if (ocupado()) { var el = document.getElementById('rv-vivo'); if (el) el.textContent = 'Hay cambios en tu grupo: al terminar verás lo más reciente.'; }
          else location.reload();
        }
      }).catch(function () {});
  }, 15000);
})();
