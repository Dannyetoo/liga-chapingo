# Liga Chapingo · /disponibilidad/
# Bloquea copias viejas de index.php (index-anterior.php escribía en MySQL sin
# revisar quién era el usuario), documentación y SQL. No borra ningún archivo.
Options -Indexes

<FilesMatch "^(index-anterior.*|index-ANTERIOR.*|db)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.(md|sql|json|log|bak|diff)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
