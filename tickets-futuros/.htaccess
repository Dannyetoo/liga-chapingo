# Tickets futuros: nadie abre desde el navegador la configuración ni las funciones.
<FilesMatch "^(config|lib|db)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
